# Copia este archivo como .env y completa las claves. Las variables sin valor por defecto
# son obligatorias: la API no arranca si faltan (ver app/config.py).

# --- Credenciales (obligatorias) ---
OPENAI_API_KEY=
PINECONE_API_KEY=

# --- Modelos ---
OPENAI_MODEL=gpt-4.1-mini
# Respaldo si el principal falla tras sus reintentos (with_fallbacks). Vacío lo desactiva.
OPENAI_FALLBACK_MODEL=gpt-4o-mini
# Tope en segundos por llamada al LLM.
LLM_TIMEOUT_SEG=60
EMBEDDING_MODEL=text-embedding-3-small
# Debe coincidir con la dimensión del índice de Pinecone.
EMBEDDING_DIM=1536

# --- Pinecone ---
# Obligatoria. Solo minúsculas, números y guiones (máx. 45 caracteres).
PINECONE_INDEX_NAME=edificio-riesco
PINECONE_NAMESPACE=consultas-convivencia
PINECONE_METRIC=cosine
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- RAG ---
CHUNK_SIZE=600
CHUNK_OVERLAP=100
ENCODING_NAME=cl100k_base
# Fragmentos que recibe el agente, y candidatos que trae cada retriever antes del re-ranking.
RAG_TOP_K=5
RAG_CANDIDATOS=20
# Peso de BM25 en la búsqueda híbrida (0 a 1); el vectorial recibe 1 - este valor.
RAG_PESO_BM25=0.5
# Re-ranking con el modelo hospedado en Pinecone (usa la misma PINECONE_API_KEY).
RERANK_ACTIVO=true
RERANK_MODEL=bge-reranker-v2-m3

# --- Grafo ---
MAX_PASOS=6
# Tope en segundos para una ejecución completa del grafo.
JOB_TIMEOUT_SEG=300

# --- Redis (estado de jobs, cola y checkpoints de LangGraph) ---
# En docker compose se sobrescribe con redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0
NUM_WORKERS=5
CHECKPOINT_TTL_MIN=1440

# --- Observabilidad (Arize Phoenix): http://localhost:6006 ---
# Vacío desactiva el envío de trazas.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT=riesco-api
